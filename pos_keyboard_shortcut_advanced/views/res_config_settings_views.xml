<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pksa" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.keyboard.shortcut</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="pksa_keyboard_shortcuts">
                    <div class="o_setting_left_pane">
                        <field name="pos_pksa_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_pksa_enabled"/>
                        <div class="text-muted">
                            Arrow-key product grid, PageUp/PageDown order lines, Enter to add the focused product
                        </div>
                        <div class="content-group mt8" attrs="{'invisible': [('pos_pksa_enabled', '=', False)]}">
                            <button name="%(pos_keyboard_shortcut_advanced.action_pos_keyboard_shortcut)d"
                                    type="action" string="Configure Shortcuts" icon="fa-arrow-right" class="btn-link"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
