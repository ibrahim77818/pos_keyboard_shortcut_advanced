<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pksa" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.keyboard.shortcut</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pksa_keyboard_shortcuts"
                         help="Arrow-key product grid, PageUp/PageDown order lines, Enter to add the focused product">
                    <field name="pos_pksa_enabled"/>
                    <div class="content-group mt8" invisible="not pos_pksa_enabled">
                        <button name="%(pos_keyboard_shortcut_advanced.action_pos_keyboard_shortcut)d"
                                type="action" string="Configure Shortcuts" icon="oi-arrow-right" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
