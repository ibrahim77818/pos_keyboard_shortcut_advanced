<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_keyboard_shortcut_advanced.ShortcutHelpPopup">
        <div class="popup pksa-help-popup">
            <div class="modal-header">
                <h4 class="modal-title title drag-handle">
                    <t t-esc="props.title"/>
                </h4>
            </div>
            <main class="modal-body">
                <t t-if="state.rows.length">
                    <table class="pksa-help-table">
                        <tbody>
                            <tr t-foreach="state.rows" t-as="row" t-key="row.action">
                                <td class="pksa-help-name"><t t-esc="row.name"/></td>
                                <td class="pksa-help-keys">
                                    <t t-foreach="row.keys" t-as="k" t-key="k">
                                        <kbd t-esc="k"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <p t-else="" class="pksa-help-empty">No keyboard shortcut is active for this Point of Sale.</p>
                <p t-if="state.message" class="pksa-help-message" t-esc="state.message"/>
            </main>
            <footer class="footer modal-footer">
                <div class="button pksa-reload btn btn-lg btn-secondary" t-att-class="{ 'disabled': state.loading }"
                     t-on-click="onClickReload">
                    <i class="fa fa-refresh" t-att-class="{ 'fa-spin': state.loading }"/> Reload
                </div>
                <div class="button cancel btn btn-lg btn-primary" t-on-click="cancel">
                    <t t-esc="props.confirmText"/>
                </div>
            </footer>
        </div>
    </t>

</templates>
